{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Postly",
  "version": "0.1.0",
  "identifier": "dev.teixas.postly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Postly",
        "width": 1280,
        "height": 840,
        "minWidth": 1040,
        "minHeight": 700,
        "resizable": true,
        "decorations": true,
        "theme": "Dark",
        "label": "main"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DATA/postly/**",
          "$DATA/Postly/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
