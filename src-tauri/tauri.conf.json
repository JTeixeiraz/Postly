{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Postly",
  "version": "0.1.2",
  "identifier": "dev.teixas.postly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Postly",
        "width": 1280,
        "height": 840,
        "minWidth": 1040,
        "minHeight": 700,
        "resizable": true,
        "decorations": true,
        "theme": "Dark",
        "label": "main"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DATA/postly/**",
          "$DATA/Postly/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "JTeixeiraz",
    "homepage": "https://jteixeiraz.github.io/Postly/",
    "license": "MIT",
    "shortDescription": "Um departamento de marketing que roda na sua máquina",
    "longDescription": "Quatro cargos de IA se revezam em modelos locais do Ollama para pesquisar o mercado, criar a peça, auditar e publicar nas suas redes. Um modelo por vez, porque numa máquina comum não cabem quatro.",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ]
      }
    },
    "resources": {
      "../sidecar/package.json": "sidecar/package.json",
      "../sidecar/package-lock.json": "sidecar/package-lock.json",
      "../sidecar/playwright-agent.mjs": "sidecar/playwright-agent.mjs",
      "../sidecar/networks.mjs": "sidecar/networks.mjs",
      "../sidecar/metricas.mjs": "sidecar/metricas.mjs",
      "../sidecar/remotion-agent.mjs": "sidecar/remotion-agent.mjs",
      "../motion/package.json": "motion/package.json",
      "../motion/tsconfig.json": "motion/tsconfig.json",
      "../motion/src/*": "motion/src/",
      "../sidecar/analise-agent.mjs": "sidecar/analise-agent.mjs"
    }
  }
}
